# OCADS Fetcher Configuration
# Copy this file to .env and update with your desired values

# Bounding box coordinates (longitude, latitude)
# Format: west_lon,south_lat,east_lon,north_lat
BBOX=-150.00000,40.00000,-40.00000,90.00000

# Extra search terms (comma-separated)
EXTRA_TERMS=pH

# Keywords for filtering
KEYWORDS=

# Time range for data (format: YYYY-MM-DD/YYYY-MM-DD)
TIME_RANGE=

# Output filename for fetched results
RESULTS_FILENAME=ocads_results.json

# Output directory for extracted data
DATASETS_DIR=datasets
